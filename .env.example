# ──────────────────────────────────────────────────────────────
# Self-Healing CI/CD Pipeline Agent — Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# Meta Model API key (from https://ai.meta.com/resources/models-and-libraries/)
META_API_KEY=your_meta_api_key_here

# GitHub Personal Access Token (requires repo scope)
GITHUB_TOKEN=your_github_personal_access_token_here

# Target GitHub repository coordinates
GITHUB_REPO_OWNER=your_github_username_or_org
GITHUB_REPO_NAME=your_target_repo_name
